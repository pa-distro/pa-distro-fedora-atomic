[Appearance]
ColorScheme=PAGreen
Font=Hack,12
UseFontLineChararacters=true

[General]
Command=/bin/zsh
Name=PA
Parent=FALLBACK/
TerminalColumns=110

[Interaction Options]
AutoCopySelectedText=true
TrimLeadingSpacesInSelectedText=false
TrimTrailingSpacesInSelectedText=true
UnderlineFilesEnabled=true

[Keyboard]
KeyBindings=default

[Scrolling]
HistoryMode=2

[Terminal Features]
BlinkingCursorEnabled=true
